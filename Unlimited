local function toggle(p,t,callback)
    local b=Instance.new("TextButton",p)
    b.Size=UDim2.new(1,-10,0,42)
    b.BackgroundColor3=Color3.fromRGB(30,30,40)
    b.BorderSizePixel=0
    b.Text=""
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,7)

    local l=Instance.new("TextLabel",b)
    l.Size=UDim2.new(1,-75,1,0)
    l.Position=UDim2.fromOffset(13,0)
    l.BackgroundTransparency=1
    l.Text=t
    l.Font=Enum.Font.GothamMedium
    l.TextSize=13
    l.TextColor3=Color3.fromRGB(225,225,230)
    l.TextXAlignment=Enum.TextXAlignment.Left

    local s=Instance.new("TextLabel",b)
    s.Size=UDim2.fromOffset(45,24)
    s.Position=UDim2.new(1,-58,.5,-12)
    s.BackgroundColor3=Color3.fromRGB(55,55,65)
    s.BorderSizePixel=0
    s.Text="OFF"
    s.Font=Enum.Font.GothamBold
    s.TextSize=10
    s.TextColor3=Color3.fromRGB(180,180,190)
    Instance.new("UICorner",s).CornerRadius=UDim.new(0,12)

    local state=false

    b.MouseButton1Click:Connect(function()
        state=not state
        s.Text=state and "ON" or "OFF"
        s.BackgroundColor3=state and Color3.fromRGB(70,110,255) or Color3.fromRGB(55,55,65)
        callback(state)
    end)
end

local function button(p,t,callback)
